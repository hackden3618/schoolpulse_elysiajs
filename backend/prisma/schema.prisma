generator client {
    provider = "prisma-client"
    output   = "../generated/prisma-client"
}

datasource db {
    provider = "postgresql"
}

/**
 * =========================
 * ENUMS
 * =========================
 */

enum JoinRequestStatus {
    submitted
    pending_review
    approved_and_verified
    approved
    verified
    rejected
    fraudulent
}

enum SchoolTier {
    small
    medium
    large
    enterprise

    @@map("school_tier")
}

enum SchoolLevel {
    pre_primary
    primary
    junior_secondary
    senior_secondary
    mixed

    @@map("school_level")
}

enum SubscriptionStatus {
    trial
    active
    suspended
    pending_review
    defaulted
    terminated

    @@map("subscription_status")
}

enum SubscriptionPlan {
    free
    monthly
    termly
    yearly
    enterprise

    @@map("subscription_plan")
}

enum UserStatus {
    active
    inactive
    archived

    @@map("user_status")
}

enum MembershipStatus {
    active
    on_leave
    suspended
    resigned
    terminated

    @@map("membership_status")
}

enum StudentStatus {
    active
    inactive
    archived
    graduated
    deceased

    @@map("student_status")
}

enum ArchiveReason {
    graduated
    dropped_out
    expelled
    transferred
    deceased
    other

    @@map("archive_reason")
}

enum Relationship {
    father
    mother
    sibling
    emergency
    sponsor
    legal_guardian
    step_parent
    relative
    other

    @@map("relationship")
}

enum EnrollmentStatus {
    active
    suspended
    transferred
    expelled
    on_leave
    medical_leave
    truant
    dropped_out
    graduated

    @@map("enrollment_status")
}

enum Gender {
    male
    female

    @@map("gender")
}

enum PerformanceExpectation {
    below_expectation
    average
    good
    excellent
    exceptional

    @@map("performance_expectation")
}

enum AttendanceStatus {
    present
    absent
    late
    excused

    @@map("attendance_status")
}

enum AttendanceSessionType {
    morning
    afternoon
    lesson

    @@map("attendance_session_type")
}

enum ExamType {
    cat
    midterm
    endterm
    mock
    opener
    continuous_assessment
    practical
    project
    oral
    national
    custom

    @@map("exam_type")
}

enum AssessmentPerformance {
    excellent
    good
    average
    below_average
    poor

    @@map("assessment_performance")
}

enum InvoiceStatus {
    draft
    issued
    partially_paid
    paid
    overdue
    cancelled
    written_off

    @@map("invoice_status")
}

enum PaymentType {
    subscription
    fee
    extra_curricular
}

enum PaymentMethod {
    mpesa_stk
    mpesa_c2b
    bank_transfer
    bursary
    cash
    adjustment
    credit

    @@map("payment_method")
}

enum PaymentStatus {
    pending
    confirmed
    failed
    reversed

    @@map("payment_status")
}

enum ConversationType {
    direct
    group
    announcement

    @@map("conversation_type")
}

enum MessageChannel {
    in_app
    sms
    whatsapp
    email

    @@map("message_channel")
}

enum MessagePriority {
    low
    normal
    high
    urgent

    @@map("message_priority")
}

enum MessageType {
    text
    announcement
    invoice
    payment
    attendance
    assessment
    system

    @@map("message_type")
}

enum ReceiptStatus {
    pending
    sent
    delivered
    failed
    read

    @@map("receipt_status")
}

enum EventStatus {
    pending
    processing
    processed
    failed
    dead_letter

    @@map("event_status")
}

enum AggregateType {
    school
    user
    membership
    student
    academic_year
    term
    class_instance
    attendance_session
    exam
    invoice
    payment
    conversation
    subscription

    @@map("aggregate_type")
}

enum EventType {
    SchoolCreated
    UserCreated
    MembershipCreated
    RoleAssigned
    StudentAdmitted
    GuardianAdded
    StudentTransferred
    StudentArchived
    AcademicYearActivated
    TermActivated
    TeacherAssigned
    AttendanceMarked
    AttendanceEdited
    InvoiceGenerated
    SubscriptionRenewed
    PaymentReceived
    PaymentReversed
    FeeReminderQueued
    ExamCreated
    AssessmentPublished
    ConversationCreated
    MessageSent
    SubscriptionExpired

    @@map("event_type")
}

/**
 * =========================
 * SchoolPulse internal management -- I set it up in this aggregated database as I will ensure it's secure
 * =========================
 */

model Subscription {
    id        String @id @default(uuid())
    schoolId  String @map("school_id") @db.Uuid
    paymentId String @map("payment_id") @db.Uuid

    subscriptionStartDate DateTime? @map("subscription_start_date") @db.Timestamptz(6)
    subscriptionEndDate   DateTime? @map("subscription_end_date") @db.Timestamptz(6)

    school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

    @@unique([schoolId, paymentId])
    @@map("subscriptions")
}

model JoinRequest {
    id          String            @id @default(uuid()) @db.Uuid
    schoolName  String            @map("school_name")
    requestedAt DateTime          @default(now()) @map("requested_at") @db.Timestamptz(6)
    requestedBy String            @map("requested_by")
    status      JoinRequestStatus @default(pending_review)
    processedBy String?           @map("processed_by")
    processedAt DateTime?         @map("processed_at") @db.Timestamptz(6)
    deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(6)
}

/**
 * =========================
 * IDENTITY AND TENANCY DOMAIN
 * =========================
 */

model User {
    id             String     @id @default(uuid()) @db.Uuid
    firstName      String     @map("first_name")
    secondName     String?    @map("second_name")
    lastName       String?    @map("last_name")
    phone          String     @unique
    email          String?    @unique
    hashedPassword String?    @map("hashed_password")
    profilePic     String?    @map("profile_pic")
    status         UserStatus @default(active)
    lastLogin      DateTime?  @map("last_login") @db.Timestamptz(6)

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    memberships              SchoolMembership[]
    guardianLinks            StudentGuardian[]
    paymentsMade             Payment[]                 @relation("PaymentPayer")
    auditLogs                AuditLog[]                @relation("AuditActorUser")
    conversationParticipants ConversationParticipant[]
    receivedMessages         Message[]                 @relation("MessageRecipient")
    messageReceipts          MessageReceipt[]

    @@map("users")
}

model Role {
    id          String  @id @default(uuid()) @db.Uuid
    name        String  @unique
    description String?
    permissions Json    @default("[]")

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    memberships SchoolMembershipRole[]

    @@map("roles")
}

model School {
    id         String @id @default(uuid()) @db.Uuid
    schoolCode String @unique @map("school_code")
    schoolName String @unique @map("school_name")

    schoolPhone   String  @unique @map("school_phone")
    schoolEmail   String? @unique @map("school_email")
    schoolWebsite String? @map("school_website")
    schoolAddress String? @map("school_address")
    schoolLogo    String? @map("school_logo")
    postOffice    String? @map("post_office")

    county  String
    town    String
    country String @default("Kenya")

    currency String @default("KES")
    timezone String @default("Africa/Nairobi")

    subscriptionPlan   SubscriptionPlan   @default(free) @map("subscription_plan")
    subscriptionStatus SubscriptionStatus @default(trial) @map("subscription_status")
    schoolTier         SchoolTier         @default(medium) @map("school_tier")
    schoolLevel        SchoolLevel        @default(mixed) @map("school_level")
    settings           Json               @default("{}")

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    memberships              SchoolMembership[]
    academicYears            AcademicYear[]
    terms                    Term[]
    classes                  Class[]
    classInstances           ClassInstance[]
    students                 Student[]
    studentGuardians         StudentGuardian[]
    enrollments              Enrollment[]
    subjects                 Subject[]
    classSubjectAssignments  ClassSubjectAssignment[]
    attendanceSessions       AttendanceSession[]
    attendanceRecords        AttendanceRecord[]
    exams                    Exam[]
    assessments              Assessment[]
    assessmentResults        AssessmentResult[]
    feeStructures            FeeStructure[]
    feeItems                 FeeItem[]
    invoices                 Invoice[]
    payments                 Payment[]
    paymentAllocations       PaymentAllocation[]
    financialAuditLogs       FinancialAuditLog[]
    conversations            Conversation[]
    conversationParticipants ConversationParticipant[]
    messages                 Message[]
    messageReceipts          MessageReceipt[]
    auditLogs                AuditLog[]
    eventOutbox              EventOutbox[]
    messageTokens            MessageToken[]
    subscriptions            Subscription[]

    @@map("schools")
}

model SchoolMembership {
    id       String @id @default(uuid()) @db.Uuid
    schoolId String @map("school_id") @db.Uuid
    userId   String @map("user_id") @db.Uuid

    status   MembershipStatus @default(active)
    joinedAt DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
    leftAt   DateTime?        @map("left_at") @db.Timestamptz(6)

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    roles                     SchoolMembershipRole[]
    classTeacherAssignments   ClassInstance[]           @relation("ClassTeacherAssignments")
    subjectTeacherAssignments ClassSubjectAssignment[]  @relation("SubjectTeacherAssignments")
    markedAttendanceSessions  AttendanceSession[]       @relation("AttendanceMarker")
    editedAttendanceRecords   AttendanceRecord[]        @relation("AttendanceRecordEditor")
    financeAuditLogs          FinancialAuditLog[]       @relation("FinanceAuditActor")
    createdPayments           Payment[]                 @relation("PaymentCreator")
    auditLogs                 AuditLog[]                @relation("AuditActorMembership")
    sentMessages              Message[]                 @relation("MessageSender")
    conversationParticipants  ConversationParticipant[]

    @@unique([schoolId, userId])
    @@index([schoolId, userId], map: "idx_memberships_school_user")
    @@map("school_memberships")
}

model SchoolMembershipRole {
    id           String @id @default(uuid()) @db.Uuid
    membershipId String @map("membership_id") @db.Uuid
    roleId       String @map("role_id") @db.Uuid

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    membership SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
    role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@unique([membershipId, roleId])
    @@map("school_membership_roles")
}

/**
 * =========================
 * ACADEMIC STRUCTURE DOMAIN
 * =========================
 */

model AcademicYear {
    id       String @id @default(uuid()) @db.Uuid
    schoolId String @map("school_id") @db.Uuid

    name      String
    startDate DateTime @map("start_date") @db.Date
    endDate   DateTime @map("end_date") @db.Date
    active    Boolean  @default(false)

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

    terms          Term[]
    classInstances ClassInstance[]
    enrollments    Enrollment[]
    feeStructures  FeeStructure[]

    @@unique([schoolId, name])
    @@map("academic_years")
}

model Term {
    id             String @id @default(uuid()) @db.Uuid
    schoolId       String @map("school_id") @db.Uuid
    academicYearId String @map("academic_year_id") @db.Uuid

    name      String
    startDate DateTime @map("start_date") @db.Date
    endDate   DateTime @map("end_date") @db.Date
    active    Boolean  @default(false)

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

    enrollments   Enrollment[]
    exams         Exam[]
    feeStructures FeeStructure[]
    invoices      Invoice[]

    @@unique([academicYearId, name])
    @@map("terms")
}

model Class {
    id       String @id @default(uuid()) @db.Uuid
    schoolId String @map("school_id") @db.Uuid

    name  String
    level Int

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

    classInstances ClassInstance[]
    feeStructures  FeeStructure[]

    @@unique([schoolId, name])
    @@map("classes")
}

model ClassInstance {
    id             String @id @default(uuid()) @db.Uuid
    schoolId       String @map("school_id") @db.Uuid
    classId        String @map("class_id") @db.Uuid
    academicYearId String @map("academic_year_id") @db.Uuid

    streamName               String  @map("stream_name")
    classTeacherMembershipId String? @map("class_teacher_membership_id") @db.Uuid
    isCurrent                Boolean @default(true) @map("is_current")

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    class        Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
    academicYear AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
    classTeacher SchoolMembership? @relation("ClassTeacherAssignments", fields: [classTeacherMembershipId], references: [id], onDelete: Cascade)

    enrollments             Enrollment[]
    classSubjectAssignments ClassSubjectAssignment[]
    attendanceSessions      AttendanceSession[]
    assessments             Assessment[]

    @@unique([classId, academicYearId, streamName])
    @@index([schoolId, academicYearId], map: "idx_class_instances_school_year")
    @@map("class_instances")
}

/**
 * =========================
 * STUDENT DOMAIN
 * =========================
 */

model Student {
    id              String  @id @default(uuid()) @db.Uuid
    schoolId        String  @map("school_id") @db.Uuid
    admissionNumber String  @map("admission_number")
    firstName       String  @map("first_name")
    secondName      String? @map("second_name")
    lastName        String  @map("last_name")

    dateOfBirth            DateTime                @map("date_of_birth") @db.Date
    gender                 Gender?
    admissionDate          DateTime                @default(now()) @map("admission_date") @db.Timestamptz(6)
    status                 StudentStatus           @default(active)
    archiveReason          ArchiveReason?          @map("archive_reason")
    performanceExpectation PerformanceExpectation? @map("performance_expectation")

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

    guardians          StudentGuardian[]
    enrollments        Enrollment[]
    attendanceRecords  AttendanceRecord[]
    assessmentResults  AssessmentResult[]
    invoices           Invoice[]
    payments           Payment[]
    paymentAllocations PaymentAllocation[]
    financialAuditLogs FinancialAuditLog[]

    @@unique([schoolId, admissionNumber])
    @@index([schoolId, status], map: "idx_students_school_status")
    @@map("students")
}

model StudentGuardian {
    id         String @id @default(uuid()) @db.Uuid
    schoolId   String @map("school_id") @db.Uuid
    studentId  String @map("student_id") @db.Uuid
    guardianId String @map("guardian_id") @db.Uuid

    relationship  Relationship @default(legal_guardian)
    isPrimary     Boolean      @default(false) @map("is_primary")
    canPay        Boolean      @default(true) @map("can_pay")
    receivesSms   Boolean      @default(true) @map("receives_sms")
    receivesEmail Boolean      @default(false) @map("receives_email")

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
    guardian User    @relation(fields: [guardianId], references: [id], onDelete: Cascade)

    @@unique([studentId, guardianId])
    @@map("student_guardians")
}

model Enrollment {
    id              String  @id @default(uuid()) @db.Uuid
    schoolId        String  @map("school_id") @db.Uuid
    studentId       String  @map("student_id") @db.Uuid
    classInstanceId String  @map("class_instance_id") @db.Uuid
    academicYearId  String  @map("academic_year_id") @db.Uuid
    termId          String? @map("term_id") @db.Uuid

    status EnrollmentStatus @default(active)

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
    classInstance ClassInstance @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)
    academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
    term          Term?         @relation(fields: [termId], references: [id], onDelete: Cascade)

    assessmentResults AssessmentResult[]
    invoices          Invoice[]

    @@unique([studentId, classInstanceId, academicYearId])
    @@index([schoolId, status], map: "idx_enrollments_school_status")
    @@map("enrollments")
}

/**
 * =========================
 * ACADEMIC DELIVERY DOMAIN
 * =========================
 */

model Subject {
    id       String @id @default(uuid()) @db.Uuid
    schoolId String @map("school_id") @db.Uuid

    name         String
    code         String
    isCompulsory Boolean @default(true) @map("is_compulsory")

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

    classSubjectAssignments ClassSubjectAssignment[]
    assessments             Assessment[]

    @@unique([schoolId, code])
    @@map("subjects")
}

model ClassSubjectAssignment {
    id                  String  @id @default(uuid()) @db.Uuid
    schoolId            String  @map("school_id") @db.Uuid
    classInstanceId     String  @map("class_instance_id") @db.Uuid
    subjectId           String  @map("subject_id") @db.Uuid
    teacherMembershipId String? @map("teacher_membership_id") @db.Uuid

    assignmentType String @default("main") @map("assignment_type")

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    classInstance ClassInstance     @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)
    subject       Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
    teacher       SchoolMembership? @relation("SubjectTeacherAssignments", fields: [teacherMembershipId], references: [id], onDelete: Cascade)

    @@unique([classInstanceId, subjectId])
    @@map("class_subject_assignments")
}

model Exam {
    id       String @id @default(uuid()) @db.Uuid
    schoolId String @map("school_id") @db.Uuid
    termId   String @map("term_id") @db.Uuid

    name        String
    type        ExamType  @default(custom)
    startDate   DateTime  @map("start_date") @db.Date
    endDate     DateTime  @map("end_date") @db.Date
    completed   Boolean   @default(false)
    published   Boolean   @default(false)
    publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

    assessments Assessment[]

    @@unique([schoolId, termId, name])
    @@map("exams")
}

model Assessment {
    id              String @id @default(uuid()) @db.Uuid
    schoolId        String @map("school_id") @db.Uuid
    examId          String @map("exam_id") @db.Uuid
    classInstanceId String @map("class_instance_id") @db.Uuid
    subjectId       String @map("subject_id") @db.Uuid

    totalMarks       Decimal @map("total_marks") @db.Decimal(6, 2)
    accountedInFinal Boolean @default(true) @map("accounted_in_final")

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    exam          Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
    classInstance ClassInstance @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)
    subject       Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

    results AssessmentResult[]

    @@unique([examId, classInstanceId, subjectId])
    @@map("assessments")
}

model AssessmentResult {
    id           String  @id @default(uuid()) @db.Uuid
    schoolId     String  @map("school_id") @db.Uuid
    studentId    String  @map("student_id") @db.Uuid
    enrollmentId String? @map("enrollment_id") @db.Uuid
    assessmentId String  @map("assessment_id") @db.Uuid

    attainedMarks Decimal                @map("attained_marks") @db.Decimal(6, 2)
    performance   AssessmentPerformance?
    remarks       String?
    published     Boolean                @default(false)

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
    enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
    assessment Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

    @@unique([assessmentId, studentId])
    @@map("assessment_results")
}

/**
 * =========================
 * ATTENDANCE DOMAIN
 * =========================
 */

model AttendanceSession {
    id                 String  @id @default(uuid()) @db.Uuid
    schoolId           String  @map("school_id") @db.Uuid
    classInstanceId    String  @map("class_instance_id") @db.Uuid
    markerMembershipId String? @map("marker_membership_id") @db.Uuid

    sessionDate DateTime              @map("session_date") @db.Date
    sessionType AttendanceSessionType @default(morning) @map("session_type")
    status      String                @default("open")
    lockedAt    DateTime?             @map("locked_at") @db.Timestamptz(6)

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    classInstance ClassInstance     @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)
    marker        SchoolMembership? @relation("AttendanceMarker", fields: [markerMembershipId], references: [id], onDelete: Cascade)

    records AttendanceRecord[]

    @@unique([classInstanceId, sessionDate, sessionType])
    @@index([schoolId, sessionDate], map: "idx_attendance_sessions_school_date")
    @@map("attendance_sessions")
}

model AttendanceRecord {
    id                   String  @id @default(uuid()) @db.Uuid
    schoolId             String  @map("school_id") @db.Uuid
    sessionId            String  @map("session_id") @db.Uuid
    studentId            String  @map("student_id") @db.Uuid
    editedByMembershipId String? @map("edited_by_membership_id") @db.Uuid

    status      AttendanceStatus
    checkInTime DateTime?        @map("check_in_time") @db.Timestamptz(6)
    editReason  String?          @map("edit_reason")
    editedAt    DateTime?        @map("edited_at") @db.Timestamptz(6)

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school  School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
    editor  SchoolMembership? @relation("AttendanceRecordEditor", fields: [editedByMembershipId], references: [id], onDelete: Cascade)

    @@unique([sessionId, studentId])
    @@index([schoolId, studentId], map: "idx_attendance_records_student")
    @@map("attendance_records")
}

/**
 * =========================
 * FINANCE DOMAIN
 * =========================
 */

model FeeStructure {
    id             String  @id @default(uuid()) @db.Uuid
    schoolId       String  @map("school_id") @db.Uuid
    academicYearId String  @map("academic_year_id") @db.Uuid
    termId         String  @map("term_id") @db.Uuid
    classId        String? @map("class_id") @db.Uuid

    isGlobal Boolean @default(false) @map("is_global")
    isLatest Boolean @default(true) @map("is_latest")

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
    term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
    class        Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)

    feeItems FeeItem[]
    invoices Invoice[]

    @@map("fee_structures")
}

model FeeItem {
    id             String @id @default(uuid()) @db.Uuid
    schoolId       String @map("school_id") @db.Uuid
    feeStructureId String @map("fee_structure_id") @db.Uuid

    name        String
    amount      Decimal @db.Decimal(12, 2)
    optional    Boolean @default(false)
    description String?

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

    @@map("fee_items")
}

model Invoice {
    id             String  @id @default(uuid()) @db.Uuid
    schoolId       String  @map("school_id") @db.Uuid
    studentId      String  @map("student_id") @db.Uuid
    enrollmentId   String? @map("enrollment_id") @db.Uuid
    termId         String  @map("term_id") @db.Uuid
    feeStructureId String? @map("fee_structure_id") @db.Uuid

    totalAmount Decimal       @map("total_amount") @db.Decimal(12, 2)
    paidAmount  Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
    balance     Decimal       @db.Decimal(12, 2)
    status      InvoiceStatus @default(issued)
    isCurrent   Boolean       @default(true) @map("is_current")

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
    enrollment   Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
    term         Term          @relation(fields: [termId], references: [id], onDelete: Cascade)
    feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

    payments           Payment[]
    paymentAllocations PaymentAllocation[]
    financialAuditLogs FinancialAuditLog[]

    @@index([schoolId, studentId], map: "idx_invoices_school_student")
    @@map("invoices")
}

model Payment {
    id                    String  @id @default(uuid()) @db.Uuid
    schoolId              String  @map("school_id") @db.Uuid
    studentId             String  @map("student_id") @db.Uuid
    payerId               String? @map("payer_id") @db.Uuid
    invoiceId             String? @map("invoice_id") @db.Uuid
    reversedPaymentId     String? @map("reversed_payment_id") @db.Uuid
    createdByMembershipId String? @map("created_by_membership_id") @db.Uuid

    method         PaymentMethod
    type           PaymentType   @default(fee)
    status         PaymentStatus @default(pending)
    provider       String?
    transactionRef String        @map("transaction_ref")
    amount         Decimal       @db.Decimal(12, 2)
    receivedAt     DateTime      @default(now()) @map("received_at") @db.Timestamptz(6)
    createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

    school              School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
    payer               User?             @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Cascade)
    invoice             Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
    reversedPayment     Payment?          @relation("PaymentReversal", fields: [reversedPaymentId], references: [id], onDelete: Cascade)
    reversalPayments    Payment[]         @relation("PaymentReversal")
    createdByMembership SchoolMembership? @relation("PaymentCreator", fields: [createdByMembershipId], references: [id], onDelete: Cascade)

    allocations        PaymentAllocation[]
    financialAuditLogs FinancialAuditLog[]
    subscriptions      Subscription[]

    @@index([schoolId, studentId], map: "idx_payments_school_student")
    @@map("payments")
}

model PaymentAllocation {
    id        String @id @default(uuid()) @db.Uuid
    schoolId  String @map("school_id") @db.Uuid
    paymentId String @map("payment_id") @db.Uuid
    invoiceId String @map("invoice_id") @db.Uuid
    studentId String @map("student_id") @db.Uuid

    amount    Decimal  @db.Decimal(12, 2)
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
    invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
    student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

    @@map("payment_allocations")
}

model FinancialAuditLog {
    id                String  @id @default(uuid()) @db.Uuid
    schoolId          String  @map("school_id") @db.Uuid
    paymentId         String? @map("payment_id") @db.Uuid
    invoiceId         String? @map("invoice_id") @db.Uuid
    actorMembershipId String? @map("actor_membership_id") @db.Uuid
    studentId         String? @map("student_id") @db.Uuid

    actionDescription String   @map("action_description")
    metadata          Json     @default("{}")
    createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    payment         Payment?          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
    invoice         Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
    actorMembership SchoolMembership? @relation("FinanceAuditActor", fields: [actorMembershipId], references: [id], onDelete: Cascade)
    student         Student?          @relation(fields: [studentId], references: [id], onDelete: Cascade)

    @@map("financial_audit_logs")
}

/**
 * =========================
 * COMMUNICATION DOMAIN
 * =========================
 */

model Conversation {
    id       String @id @default(uuid()) @db.Uuid
    schoolId String @map("school_id") @db.Uuid

    type    ConversationType
    subject String?

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

    participants ConversationParticipant[]
    messages     Message[]

    @@map("conversations")
}

model MessageToken {
    id              String         @id @default(uuid()) @db.Uuid
    schoolId        String         @map("school_id") @db.Uuid
    type            MessageChannel @default(sms)
    expiry          DateTime       @db.Timestamptz(6)
    availableTokens Int            @default(0) @map("available_tokens")

    school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

    @@unique([schoolId, type])
    @@map("message_tokens")
}

model ConversationParticipant {
    id             String  @id @default(uuid()) @db.Uuid
    schoolId       String  @map("school_id") @db.Uuid
    conversationId String  @map("conversation_id") @db.Uuid
    userId         String? @map("user_id") @db.Uuid
    membershipId   String? @map("membership_id") @db.Uuid

    participantType String @map("participant_type")

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
    membership   SchoolMembership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

    @@map("conversation_participants")
}

model Message {
    id                 String  @id @default(uuid()) @db.Uuid
    schoolId           String  @map("school_id") @db.Uuid
    conversationId     String? @map("conversation_id") @db.Uuid
    senderMembershipId String? @map("sender_membership_id") @db.Uuid
    recipientUserId    String? @map("recipient_user_id") @db.Uuid

    channel     MessageChannel  @default(in_app)
    messageType MessageType     @default(text) @map("message_type")
    priority    MessagePriority @default(normal)
    subject     String?
    content     String
    payload     Json            @default("{}")
    isLatest    Boolean         @default(true) @map("is_latest")

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    conversation Conversation?     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    sender       SchoolMembership? @relation("MessageSender", fields: [senderMembershipId], references: [id], onDelete: Cascade)
    recipient    User?             @relation("MessageRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

    receipts MessageReceipt[]

    @@index([schoolId, createdAt(sort: Desc)], map: "idx_messages_school_created")
    @@map("messages")
}

model MessageReceipt {
    id              String  @id @default(uuid()) @db.Uuid
    schoolId        String  @map("school_id") @db.Uuid
    messageId       String  @map("message_id") @db.Uuid
    recipientUserId String? @map("recipient_user_id") @db.Uuid

    status            ReceiptStatus  @default(pending)
    channel           MessageChannel
    providerMessageId String?        @map("provider_message_id")

    createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
    deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    school        School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    message       Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
    recipientUser User?   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

    @@map("message_receipts")
}

/**
 * =========================
 * AUDIT AND EVENTING DOMAIN
 * =========================
 */

model AuditLog {
    id                String  @id @default(uuid()) @db.Uuid
    schoolId          String? @map("school_id") @db.Uuid
    actorUserId       String? @map("actor_user_id") @db.Uuid
    actorMembershipId String? @map("actor_membership_id") @db.Uuid

    action    String
    tableName String  @map("table_name")
    recordId  String? @map("record_id") @db.Uuid
    oldValue  Json?   @map("old_value")
    newValue  Json?   @map("new_value")
    ipAddress String? @map("ip_address") @db.Inet
    userAgent String? @map("user_agent")

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    school          School?           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    actorUser       User?             @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: Cascade)
    actorMembership SchoolMembership? @relation("AuditActorMembership", fields: [actorMembershipId], references: [id], onDelete: Cascade)

    @@index([schoolId, createdAt(sort: Desc)], map: "idx_audit_logs_school_created")
    @@map("audit_logs")
}

model EventOutbox {
    id          String  @id @default(uuid()) @db.Uuid
    schoolId    String? @map("school_id") @db.Uuid
    aggregateId String  @map("aggregate_id") @db.Uuid

    aggregateType    AggregateType @map("aggregate_type")
    eventType        EventType     @map("event_type")
    payload          Json
    status           EventStatus   @default(pending)
    retryCount       Int           @default(0) @map("retry_count")
    experiencedError Boolean       @default(false) @map("experienced_error")
    errorMessage     String?       @map("error_message")

    createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
    processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
    nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)

    school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

    @@index([status, nextAttemptAt, createdAt], map: "idx_event_outbox_status_next_attempt")
    @@map("event_outbox")
}

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma-client"
}

datasource db {
    provider = "postgresql"
}

/**
 * =========================
 * ENUMS
 * =========================
 */

enum SchoolTier {
    small
    medium
    large
    enterprise
}

enum SubscriptionStatus {
    trial
    active
    suspended
    pending_review
    defaulted
    terminated
}

enum SubscriptionPlan {
    free
    monthly
    termly
    yearly
}

enum UserStatus {
    active
    inactive
    archived
}

enum MembershipStatus {
    active
    on_leave
    suspended
    resigned
    terminated
}

enum EnrollmentStatus {
    active
    suspended
    transferred
    expelled
    on_leave
    medical_leave
    truant
    dropped_out
}

enum StudentStatus {
    active
    inactive
    archived
    graduated
    deceased
}

enum Relationship {
    father
    mother
    sibling
    emergency
    sponsor
    legal_guardian
    step_parent
    relative
    other
}

enum ArchiveReason {
    graduated
    dropped_out
    expelled
    transferred
    deceased
    other
}

enum AttendanceStatus {
    present
    absent
    late
    excused
}

enum SessionType {
    morning
    afternoon
    lesson
}

/**
 * =========================
 * IDENTITY DOMAIN
 * =========================
 */

model User {
    id             String     @id @default(uuid()) @db.Uuid
    firstName      String     @map("first_name")
    secondName     String?    @map("second_name")
    lastName       String?    @map("last_name")
    phone          String     @unique
    email          String?    @unique
    hashedPassword String     @map("hashed_password")
    profilePic     String?    @map("profile_pic")
    status         UserStatus @default(active)

    createdAt DateTime  @default(now()) @db.Timestamptz
    updatedAt DateTime  @updatedAt @db.Timestamptz
    deletedAt DateTime? @db.Timestamptz
    lastLogin DateTime?

    memberships   SchoolMembership[]
    guardianLinks StudentGuardian[]

    @@map("users")
}

model Role {
    id          String  @id @default(uuid()) @db.Uuid
    name        String  @unique
    description String?

    memberships MembershipRole[]

    @@map("roles")
}

model School {
    id         String @id @default(uuid()) @db.Uuid
    schoolCode String @map("school_code")
    schoolName String @unique @map("school_name")

    schoolPhone String  @unique @map("school_phone")
    schoolEmail String? @unique @map("school_email")

    schoolAddress String? @map("school_address")
    county        String
    town          String
    country       String  @default("Kenya")

    currency String @default("KES")
    timezone String @default("Africa/Nairobi")

    subscriptionStatus SubscriptionStatus @default(trial)
    subscriptionPlan   SubscriptionPlan   @default(free)

    schoolTier SchoolTier @default(medium)

    createdAt DateTime  @default(now()) @db.Timestamptz
    updatedAt DateTime  @updatedAt @db.Timestamptz
    deletedAt DateTime? @db.Timestamptz

    memberships   SchoolMembership[]
    academicYears AcademicYear[]
    students      Student[]
    streams       Stream[]

    @@map("schools")
}

model SchoolMembership {
    id       String @id @default(uuid()) @db.Uuid
    schoolId String @db.Uuid
    userId   String @db.Uuid

    status MembershipStatus @default(active)

    school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    roles MembershipRole[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([schoolId, userId])
    @@map("school_memberships")
}

model MembershipRole {
    id           String @id @default(uuid()) @db.Uuid
    membershipId String @db.Uuid
    roleId       String @db.Uuid

    membership SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
    role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@unique([membershipId, roleId])
    @@map("membership_roles")
}

/**
 * =========================
 * ACADEMIC STRUCTURE DOMAIN
 * =========================
 */

model Stream {
    id              String  @id @default(uuid()) @db.Uuid
    name            String
    schoolId        String  @db.Uuid
    classTemplateId String? @db.Uuid

    school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

    classInstances ClassInstance[]
    classTemplate  ClassTemplate?  @relation(fields: [classTemplateId], references: [id])

    @@unique([name, schoolId])
    @@map("streams")
}

model AcademicYear {
    id       String @id @default(uuid()) @db.Uuid
    name     String
    schoolId String @db.Uuid

    startDate DateTime @db.Date
    endDate   DateTime @db.Date

    active Boolean @default(false)

    school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

    terms          Term[]
    classInstances ClassInstance[]
    enrollments    Enrollment[]

    @@unique([name, schoolId])
    @@map("academic_years")
}

model Term {
    id             String @id @default(uuid()) @db.Uuid
    name           String
    academicYearId String @db.Uuid

    startDate DateTime @db.Date
    endDate   DateTime @db.Date
    active    Boolean  @default(false)

    academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

    enrollments Enrollment[]

    @@unique([academicYearId, name])
    @@map("terms")
}

/**
 * =========================
 * CORE ACADEMIC STRUCTURE (DDD FIX)
 * =========================
 */

model ClassTemplate {
    id       String @id @default(uuid()) @db.Uuid
    schoolId String @db.Uuid

    name  String
    level Int

    streams        Stream[]
    classInstances ClassInstance[]

    @@unique([schoolId, name])
    @@map("class_templates")
}

model ClassInstance {
    id String @id @default(uuid()) @db.Uuid

    classTemplateId String  @db.Uuid
    academicYearId  String  @db.Uuid
    streamId        String  @db.Uuid
    classTeacherId  String? @db.Uuid

    classTemplate ClassTemplate @relation(fields: [classTemplateId], references: [id], onDelete: Cascade)
    academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
    stream        Stream        @relation(fields: [streamId], references: [id], onDelete: Cascade)

    enrollments        Enrollment[]
    classSubjects      ClassSubject[]
    attendanceSessions AttendanceSession[]

    @@unique([classTemplateId, academicYearId, streamId])
    @@map("class_instances")
}

/**
 * =========================
 * STUDENT DOMAIN
 * =========================
 */

model Student {
    id              String  @id @default(uuid()) @db.Uuid
    admissionNumber String
    firstName       String
    secondName      String?
    lastName        String

    dateOfBirth DateTime @db.Date
    schoolId    String @db.Uuid

    status StudentStatus @default(active)

    school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

    guardians         StudentGuardian[]
    enrollments       Enrollment[]
    assessmentResults AssessmentResult[]

    @@unique([schoolId, admissionNumber])
    @@map("students")
}

model StudentGuardian {
    id         String @id @default(uuid()) @db.Uuid
    studentId  String @db.Uuid
    guardianId String @db.Uuid

    relationship Relationship @default(legal_guardian)

    student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
    guardian User    @relation(fields: [guardianId], references: [id], onDelete: Cascade)

    @@unique([studentId, guardianId])
    @@map("student_guardians")
}

model Enrollment {
    id String @id @default(uuid()) @db.Uuid

    studentId       String @db.Uuid
    classInstanceId String @db.Uuid
    academicYearId  String @db.Uuid
    termId          String? @db.Uuid

    status EnrollmentStatus @default(active)

    student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
    classInstance ClassInstance @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)
    academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
    term          Term?         @relation(fields: [termId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([studentId, classInstanceId, academicYearId])
    @@map("enrollments")
}

/**
 * =========================
 * ACADEMIC DELIVERY DOMAIN
 * =========================
 */

model Subject {
    id       String @id @default(uuid()) @db.Uuid
    schoolId String @db.Uuid

    name String
    code String

    classSubjects ClassSubject[]

    @@unique([schoolId, code])
    @@map("subjects")
}

model ClassSubject {
    id String @id @default(uuid()) @db.Uuid

    classInstanceId String @db.Uuid
    subjectId       String @db.Uuid
    teacherId       String @db.Uuid

    classInstance ClassInstance @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)
    subject       Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

    @@unique([classInstanceId, subjectId])
    @@map("class_subjects")
}

model Assessment {
    id String @id @default(uuid()) @db.Uuid

    classInstanceId String @db.Uuid
    subjectId       String @db.Uuid

    type       String
    totalMarks Int

    results AssessmentResult[]

    @@map("assessments")
}

model AssessmentResult {
    id String @id @default(uuid()) @db.Uuid

    assessmentId String @db.Uuid
    studentId    String @db.Uuid

    marks Float

    assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
    student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

    @@unique([assessmentId, studentId])
    @@map("assessment_results")
}

/**
 * =========================
 * ATTENDANCE DOMAIN
 * =========================
 */

model AttendanceSession {
    id String @id @default(uuid()) @db.Uuid

    classInstanceId String @db.Uuid
    sessionDate     DateTime
    sessionType     SessionType

    status String @default("open")

    records       AttendanceRecord[]
    classInstance ClassInstance      @relation(fields: [classInstanceId], references: [id])

    @@map("attendance_sessions")
}

model AttendanceRecord {
    id String @id @default(uuid()) @db.Uuid

    sessionId String @db.Uuid
    studentId String @db.Uuid

    status AttendanceStatus

    checkInTime DateTime?

    session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    @@unique([sessionId, studentId])
    @@map("attendance_records")
}

/**
 * =========================
 * FINANCE DOMAIN (SIMPLIFIED CORE)
 * =========================
 */

model Invoice {
    id String @id @default(uuid()) @db.Uuid

    studentId String @db.Uuid
    total     Float
    balance   Float

    status String

    payments Payment[]

    @@map("invoices")
}

model Payment {
    id String @id @default(uuid()) @db.Uuid

    invoiceId      String @db.Uuid
    amount         Float
    method         String
    transactionRef String

    createdAt DateTime @default(now())

    invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

    @@map("payments")
}

/**
 * =========================
 * DISCIPLINE DOMAIN
 * =========================
 */

model DisciplineCase {
    id String @id @default(uuid()) @db.Uuid

    studentId   String @db.Uuid
    severity    String
    status      String
    description String

    createdAt DateTime @default(now())

    @@map("discipline_cases")
}

/**
 * =========================
 * COMMUNICATION DOMAIN
 * =========================
 */

model Conversation {
    id String @id @default(uuid()) @db.Uuid

    type String

    messages Message[]

    @@map("conversations")
}

model Message {
    id String @id @default(uuid()) @db.Uuid

    conversationId String @db.Uuid
    senderId       String @db.Uuid
    content        String

    createdAt DateTime @default(now())

    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    @@map("messages")
}
